# --- IGNORED FILES (Optimized .gitignore) ---

# 1. DEPENDENCIES & BUILD OUTPUT (General)
# Dependencies should never be committed to Git.
/node_modules
/target
/build
/dist

# 2. APPLICATION/FRAMEWORK SPECIFIC EXCLUSIONS
# Vue/Node.js specific outputs and dependencies within the 'vue' directory.
vue/node_modules
vue/dist
vue/*.log

# Go/CometBFT Binary Output
# Ditch all compiled application binaries in the 'cmd' directory.
cmd/rollappd/rollappd

# Release artifacts (tarballs, zips, etc.)
/release/

# 3. ENVIRONMENT & SECURITY FILES
# Security-sensitive environment variables and their compiled forms.
.env
.env.local
.env.*.local
.DS_Store

# 4. IDE & EDITOR CONFIGURATION
# Local configuration files generated by IDEs (Integrated Development Environments).
.idea/                          # JetBrains IDEs (IntelliJ, WebStorm)
.vscode/                        # Visual Studio Code settings
*.swp                           # Vim swap files

# 5. CUSTOM/INTERNAL CONFIGURATION
# Project-specific configuration that may contain local paths or machine-specific data.
repomix.config.json
